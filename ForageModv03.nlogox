    <switch x="746" y="15" height="33" on="false" variable="export?" display="export?" width="104" sizeVersion="0"></switch>
    <chooser x="323" y="70" height="45" variable="veg-distribution" current="0" display="veg-distribution" width="110" sizeVersion="0">
      <choice type="string" value="random"></choice>
      <choice type="string" value="clustered"></choice>
    </chooser>
    <plot x="1014" autoPlotX="true" yMax="10.0" autoPlotY="true" y="77" xMin="0.0" height="150" legend="false" xMax="10.0" yMin="0.0" display="Forager Interactions" width="186" sizeVersion="0">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="all_interactions" color="-7858858" legend="true">
        <setup></setup>
        <update><![CDATA[ifelse count foragers > 0 [ plot mean [ interactions ] of foragers ] [ plot 0 ]]]></update>
      </pen>
      <pen interval="1.0" mode="0" display="same_interactions" color="-1664597" legend="true">
        <setup></setup>
        <update><![CDATA[ifelse count foragers > 2 [ plot mean [ same-interactions ] of foragers] [ plot 0 ]]]></update>
      </pen>
