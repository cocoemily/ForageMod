    <slider x="17" step="50" y="51" max="500" display="veg-type-modifier" height="33" min="50" direction="Horizontal" default="200.0" variable="veg-type-modifier" width="164" sizeVersion="0"></slider>
    <button x="356" y="16" height="33" disableUntilTicks="false" forever="false" kind="Observer" display="go-once" width="85" sizeVersion="0">go</button>
    <slider x="451" step="100" y="81" max="2000" display="cycle-duration" height="33" min="0" direction="Horizontal" default="100.0" variable="cycle-duration" units="ticks" width="154" sizeVersion="0"></slider>
