    </plot>
    <plot x="825" autoPlotX="true" yMax="1.0" autoPlotY="true" y="402" xMin="0.0" height="150" legend="false" xMax="10.0" yMin="-1.0" display="Burning Behavior" width="187" sizeVersion="0">
