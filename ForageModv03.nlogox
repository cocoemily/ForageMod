    <view x="205" wrappingAllowedX="true" y="123" frameRate="30.0" minPycor="-25" height="417" showTickCounter="true" patchSize="8.0" fontSize="10" wrappingAllowedY="true" width="416" tickCounterLabel="ticks" maxPycor="25" updateMode="1" maxPxcor="25" minPxcor="-25"></view>
    <button x="212" y="16" height="33" disableUntilTicks="false" forever="false" kind="Observer" width="63" sizeVersion="0">setup</button>
    <slider x="17" step="0.001" y="13" max="0.01" display="natural-ignition" height="33" min="0" direction="Horizontal" default="0.005" variable="natural-ignition" width="164" sizeVersion="0"></slider>
    <button x="282" y="16" height="33" disableUntilTicks="false" forever="true" kind="Observer" width="63" sizeVersion="0">go</button>
    <plot x="633" autoPlotX="true" yMax="10.0" autoPlotY="true" y="77" xMin="0.0" height="150" legend="false" xMax="10.0" yMin="0.0" display="Population" width="186" sizeVersion="0">
