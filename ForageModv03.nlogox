    <slider x="17" step="1" y="131" max="8" display="burnt-neighbor-limit" height="33" min="0" direction="Horizontal" default="4.0" variable="burnt-neighbor-limit" width="164" sizeVersion="0"></slider>
    <input x="467" multiline="false" y="10" height="60" variable="tick-limit" type="number" width="76" sizeVersion="0">3500.0</input>
    <plot x="635" autoPlotX="true" yMax="1.0" autoPlotY="true" y="402" xMin="0.0" height="150" legend="false" xMax="10.0" yMin="0.0" display="Forager Moves" width="186" sizeVersion="0">
      <setup></setup>
