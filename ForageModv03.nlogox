    <plot x="824" autoPlotX="true" yMax="10.0" autoPlotY="true" y="77" xMin="0.0" height="150" legend="false" xMax="120.0" yMin="0.0" display="Age Structure" width="186" sizeVersion="0">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="1" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>histogram [ age ] of foragers</update>
      </pen>
    </plot>
    <plot x="1016" autoPlotX="true" yMax="10.0" autoPlotY="true" y="402" xMin="0.0" height="150" legend="true" xMax="10.0" yMin="0.0" display="Self vs Other Benefit" width="185" sizeVersion="0">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Self" color="-955883" legend="true">
        <setup></setup>
        <update>plot self-burn</update>
      </pen>
      <pen interval="1.0" mode="0" display="Other" color="-13345367" legend="true">
        <setup></setup>
        <update>plot other-burn</update>
      </pen>
